{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seaweed-harvest.example/schemas/implementation-plan.schema.json",
  "title": "Seaweed Suggestion Implementation Plan",
  "description": "Reviewable implementation plan produced from an assessment. In shadow mode this plan cannot authorize coding, merge or deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "assessment_id",
    "status",
    "created_at",
    "target",
    "git",
    "risk_lane",
    "problem_statement",
    "scope",
    "acceptance_checks",
    "implementation_steps",
    "tests",
    "rollback",
    "approvals",
    "automation",
    "progress"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]{5,79}$"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^ASMT-[A-Z0-9][A-Z0-9._-]{5,79}$"
    },
    "status": {
      "enum": [
        "draft",
        "awaiting_coding_approval",
        "approved_for_future_pilot",
        "cancelled",
        "completed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "source_repository",
        "source_branch"
      ],
      "properties": {
        "target_key": {
          "enum": [
            "seaweed-harvest",
            "seaweed-tide-planner"
          ]
        },
        "source_repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "source_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_base_commit",
        "proposed_branch",
        "base_verified_at"
      ],
      "properties": {
        "exact_base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "proposed_branch": {
          "type": "string",
          "pattern": "^(agent|codex|automation)/[a-z0-9][a-z0-9._/-]{2,150}$"
        },
        "base_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "risk_lane": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "predicted_paths"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "excluded": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "predicted_paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{2,3}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "implementation_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "description",
          "protected_work"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "protected_work": {
            "type": "boolean"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command_or_method",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "command_or_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "steps",
        "data_restore_required"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "revert_commit",
            "disable_feature",
            "restore_backup",
            "manual_remediation",
            "not_applicable"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          }
        },
        "data_restore_required": {
          "type": "boolean"
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coding",
        "merge",
        "deployment"
      ],
      "properties": {
        "coding": {
          "enum": [
            "not_requested",
            "required",
            "approved",
            "rejected"
          ]
        },
        "merge": {
          "enum": [
            "not_requested",
            "required",
            "approved",
            "rejected"
          ]
        },
        "deployment": {
          "enum": [
            "not_requested",
            "required",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coding_authorized",
        "pull_request_authorized",
        "merge_authorized",
        "deployment_authorized"
      ],
      "properties": {
        "coding_authorized": {
          "const": false
        },
        "pull_request_authorized": {
          "const": false
        },
        "merge_authorized": {
          "const": false
        },
        "deployment_authorized": {
          "const": false
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "completed_steps",
        "blocked_by"
      ],
      "properties": {
        "stage": {
          "enum": [
            "planned",
            "awaiting_approval",
            "blocked",
            "cancelled",
            "complete"
          ]
        },
        "completed_steps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "blocked_by": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
